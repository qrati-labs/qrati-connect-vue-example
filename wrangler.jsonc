{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrati-connect-vue-example",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "*qrati.com/connect/vue-example*",
      "zone_name": "qrati.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
